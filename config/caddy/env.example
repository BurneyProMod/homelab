# Deployment-time secrets for the HA Caddy pair.
# Copy this file to `config/caddy/.env` on each node (git-ignored) and load
# it from the caddy systemd unit (EnvironmentFile=). Never commit values.

# bcrypt hash for the pi.lan basic-auth user "npburney".
# Generate a new one with: caddy hash-password
PI_BASIC_AUTH_HASH=

# Shared keepalived VRRP auth password (PASS). Same value on both nodes.
KEEPALIVED_AUTH_PASS=
