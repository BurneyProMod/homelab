# --- pi.lan (formerly caddy 103, pve-core); LAN/WireGuard only, basic auth ---

pi.lan {
	@lan remote_ip 192.168.1.0/24 10.8.0.0/24 127.0.0.1/8

	handle @lan {
		basic_auth {
			npburney {$PI_BASIC_AUTH_HASH}
		}

		reverse_proxy 10.31.0.2:43121
	}

	handle {
		respond "LAN access only" 403
	}
}

# --- NEW: Proxmox cluster web UI through the front door ---
# Proxmox serves its own self-signed cert on :8006; upstream TLS is not verified.
# The UI on any node manages the whole cluster.

pve.lan {
	reverse_proxy https://192.168.1.30:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
