# Burney Homelab HA Caddy — public-cert architecture (2026-08-07)
# Nodes: caddy 103 (pve-core, 192.168.1.42, prio 150) + caddy 101 (pve-gpu, 192.168.1.40, prio 100)
# keepalived VIP 192.168.1.10. Deployed identically to both nodes.
#
# All services live on *.burney.network and get Let's Encrypt certs via
# Cloudflare DNS-01 (TXT only — no public A records, no WAN exposure).
# Both nodes issue and renew their own certs independently.
#
# SECURITY: every site is gated to LAN (192.168.1.0/24) + WireGuard
# (10.8.0.0/24) + loopback. Anything else gets 403. The OPNsense firewall
# additionally allows no WAN -> VIP traffic; no public DNS records exist
# for these names.

{
	# ACME account email redacted for public repo
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# DNS-01 via Cloudflare, resolved via public resolvers so certmagic can find
# the zone's SOA (the internal OPNsense resolver has no SOA for burney.network).
(tls_le_dns) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
		propagation_timeout 5m
	}
}

# Shared LAN + WireGuard gate. Sites that just proxy use this snippet.
(proxy_lan) {
	@allowed remote_ip 192.168.1.0/24 10.8.0.0/24 127.0.0.1/8
	handle @allowed {
		reverse_proxy {args[0]}
	}
	handle {
		respond 403
	}
}



# Authentik embedded outpost forward auth (single-application mode).
# Calls the outpost on 192.168.1.66:9000; /outpost.goauthentik.io/* is served by the outpost.
(forward_auth) {
	route {
		reverse_proxy /outpost.goauthentik.io/* http://192.168.1.66:9000
		forward_auth http://192.168.1.66:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			trusted_proxies private_ranges
		}
		reverse_proxy {args[0]}
	}
}

# --- identity / SSO ---

auth.burney.network {
	import tls_le_dns
	import proxy_lan 192.168.1.66:9000
}

