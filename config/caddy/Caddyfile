# --- pi-agent (formerly pi.lan on caddy 103); basic auth + LAN gate ---

pi.burney.network {
	import tls_le_dns
	@allowed remote_ip 192.168.1.0/24 10.8.0.0/24 127.0.0.1/8
	handle @allowed {
		route {
			reverse_proxy /outpost.goauthentik.io/* http://192.168.1.66:9000
			forward_auth http://192.168.1.66:9000 {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
				trusted_proxies private_ranges
			}
			basic_auth {
				npburney {$PI_BASIC_AUTH_HASH}
			}
			reverse_proxy 10.31.0.2:43121
		}
	}
	handle {
		respond 403
	}
}

# --- Proxmox cluster web UI (formerly pve.lan) ---
# Upstream TLS is self-signed; not verified. UI on any node manages the cluster.

pve.burney.network {
	import tls_le_dns
	@allowed remote_ip 192.168.1.0/24 10.8.0.0/24 127.0.0.1/8
	handle @allowed {
		reverse_proxy https://192.168.1.30:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
	handle {
		respond 403
	}
}
