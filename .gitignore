# Ansible
*.retry

# OS
.DS_Store
Thumbs.db

# Secrets / sensitive
*.pem
*.key
.env
*secret.yml
secrets/homelab.env

# Logs
*.log

# Everything in docker not compose.yaml or .env.example
/docker/**
!/docker/**/
!/docker/**/compose.yaml
!/docker/**/docker-compose.yml
!/docker/**/.env.example
# Explicitly ignore runtime data directories that could be copied into the repo
/docker/servarr/*/config/
/docker/*/data/
/docker/*/db/

# Everything in config/ except .example files
/config/**
!/config/**/
!/config/**/*.example
!/config/caddy/Caddyfile
!/config/caddy/README.md
!/config/step-ca/root_ca.crt
!/config/step-ca/README.md
!/config/caddy/crossroutes.sh
!/config/caddy/crossroute.service
!/config/caddy/check_caddy.sh
!/config/caddy/keepalived.conf.example

# Local runtime data / legacy PVC snapshots copied into the repo — never commit
/data/**
.openclaude/

# llmeter build deps
!/docker/llmeter/Dockerfile
!/docker/llmeter/app.py
!/docker/openchamber/Dockerfile
!/docker/openchamber/entrypoint.sh
# caddy edge config (HA pair; matches config/caddy/Caddyfile)
!/docker/caddy/Caddyfile
# filebrowser config (redacted; real config on LXC 114)
!/docker/filebrowser-quantum/config.yaml

# ollama per-model Modelfiles (num_ctx 65536, applied on burndev 2026-08-14)
!/docker/ollama/modelfiles/
!/docker/ollama/modelfiles/Modelfile.*
