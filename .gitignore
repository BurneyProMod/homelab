# Ansible
*.retry

# OS
.DS_Store
Thumbs.db

# Secrets / sensitive
*.pem
*.key
.env
*secret.yml
secrets/homelab.env

# Logs
*.log

# Everything in docker not compose.yaml or .env.example
/docker/**
!/docker/**/
!/docker/**/compose.yaml
!/docker/**/docker-compose.yml
!/docker/**/.env.example
# Explicitly ignore runtime data directories that could be copied into the repo
/docker/servarr/*/config/
/docker/*/data/
/docker/*/db/

# Everything in config/ except homepage configs and .example files
/config/**
!/config/**/
!/config/homepage/config/services.yaml
!/config/homepage/config/settings.yaml
!/config/homepage/config/widgets.yaml
!/config/homepage/config/bookmarks.yaml
!/config/homepage/config/kubernetes.yaml
!/config/homepage/config/docker.yaml
!/config/homepage/config/custom.js
!/config/homepage/config/custom.css
!/config/**/*.example
!/config/caddy/Caddyfile
!/config/caddy/README.md
!/config/step-ca/root_ca.crt
!/config/step-ca/README.md
!/config/caddy/crossroutes.sh
!/config/caddy/crossroute.service
!/config/caddy/check_caddy.sh
!/config/caddy/keepalived.conf.example
