# Authentik secrets: the live .env lives on LXC 118 at /opt/authentik/.env (chmod 600, git-ignored).
PG_DB=authentik
PG_USER=authentik
# Generate with: openssl rand -base64 36 | tr -d "\n"
PG_PASS=change-me
# Generate with: openssl rand -base64 60 | tr -d "\n"
AUTHENTIK_SECRET_KEY=change-me
# Bootstrap akadmin (read only on first startup; never change after install)
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@burndev.lan
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
COMPOSE_PORT_HTTP=9000
# Google OAuth source (social login). Create OAuth client at console.cloud.google.com
# (Web application; authorized redirect URI: https://auth.burney.network/source/oauth/callback/google/)
AK_GOOGLE_CLIENT_ID=change-me
AK_GOOGLE_CLIENT_SECRET=change-me
