# LLDAP admin user (used to log into the web UI)
LLDAP_LDAP_USER_EMAIL=admin@burndev.lan
# Admin password — generate with: openssl rand -base64 24
LLDAP_LDAP_USER_PASS=change-me
# JWT secret — generate with: openssl rand -base64 48
LLDAP_JWT_SECRET=change-me
# Key seed — generate with: openssl rand -base64 32
LLDAP_KEY_SEED=change-me
