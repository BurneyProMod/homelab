# Vikunja OIDC (Authentik). Live .env is git-ignored on the deployed host.
VIKUNJA_SERVICE_PUBLICURL=https://vikunja.burney.network/
VIKUNJA_SERVICE_SECRET=change-me
VIKUNJA_AUTH_OPENID_ENABLED=true
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_NAME=Login with Authentik
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_AUTHURL=https://auth.burney.network/application/o/vikunja/
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_CLIENTID=vikunja
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_CLIENTSECRET=change-me
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_SCOPE="openid profile email"
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_USERNAMEFALLBACK=true
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_EMAILFALLBACK=true
