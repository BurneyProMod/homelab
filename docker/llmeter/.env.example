# Numeric identity of npburney on burndev.
PUID=1000
PGID=1000

TZ=America/Chicago
PORT=8080
DB_PATH=/data/llmeter.db
SESSIONS_DIR=/pi-sessions
SCAN_SECONDS=30
BALANCE_POLL_SECONDS=300

DEEPSEEK_KEY_FILE=/run/secrets/llmeter/deepseek_api_key
KIMI_KEY_FILE=/run/secrets/llmeter/moonshot_api_key

# DeepSeek and Kimi use live provider balances.
# TARGET is the denominator used by the progress bar.
DEEPSEEK_TARGET_USD=20
KIMI_TARGET_USD=20

# OpenAI and Anthropic have local ledgers based on Pi session costs.
OPENAI_BUDGET_USD=20
ANTHROPIC_BUDGET_USD=20

# Replace these with the moment each budget should begin.
DEEPSEEK_BUDGET_START=2026-07-19T00:00:00-05:00
KIMI_BUDGET_START=2026-07-19T00:00:00-05:00
OPENAI_BUDGET_START=2026-07-19T00:00:00-05:00
ANTHROPIC_BUDGET_START=2026-07-19T00:00:00-05:00
