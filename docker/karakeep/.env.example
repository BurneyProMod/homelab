# Karakeep secrets/OIDC (Authentik). Live .env is git-ignored on LXC 113.
KARAKEEP_VERSION=release
NEXTAUTH_URL=https://karakeep.burney.network
NEXTAUTH_SECRET=change-me
MEILI_MASTER_KEY=change-me
# --- OIDC (Authentik) ---
OAUTH_WELLKNOWN_URL=https://auth.burney.network/application/o/karakeep/.well-known/openid-configuration
OAUTH_CLIENT_ID=karakeep
OAUTH_CLIENT_SECRET=change-me
OAUTH_PROVIDER_NAME=Authentik
OAUTH_SCOPE="openid email profile"
OAUTH_AUTO_REDIRECT=false
DISABLE_PASSWORD_AUTH=false
OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING=true
